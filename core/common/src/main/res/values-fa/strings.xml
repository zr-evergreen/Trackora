    <string name="date_today">امروز</string>
    <string name="date_yesterday">دیروز</string>
    <string name="date_tomorrow">فردا</string>
    <!-- Persian does not inflect the noun after a number — روز stays روز for
         every count — so both quantity forms are identical by design. -->
    <plurals name="date_days_ago">
        <item quantity="one">%1$d روز پیش</item>
        <item quantity="other">%1$d روز پیش</item>
    </plurals>
    <plurals name="date_in_days">
        <item quantity="one">%1$d روز دیگر</item>
        <item quantity="other">%1$d روز دیگر</item>
    </plurals>

