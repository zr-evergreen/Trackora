<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Relative date labels. -->
    <string name="date_today">Today</string>
    <string name="date_yesterday">Yesterday</string>
    <string name="date_tomorrow">Tomorrow</string>

    <!-- These only ever receive counts of two or more, since -1, 0 and +1 are
         handled by the named labels above. They are plurals anyway: the "one"
         form costs nothing and stops the resource being wrong if the caller's
         range ever widens. -->
    <plurals name="date_days_ago">
        <item quantity="one">%1$d day ago</item>
        <item quantity="other">%1$d days ago</item>
    </plurals>
    <plurals name="date_in_days">
        <item quantity="one">In %1$d day</item>
        <item quantity="other">In %1$d days</item>
    </plurals>

    <!-- Jalali date picker. These were previously hardcoded in the composable
         and selected with a boolean, which meant the dialog's language was
         whatever the caller passed rather than the language the user chose. -->
    <string name="date_picker_title">Select Date</string>
    <string name="date_picker_year">Year</string>
    <string name="date_picker_month">Month</string>
    <string name="date_picker_day">Day</string>
    <string name="date_picker_cancel">Cancel</string>
    <string name="date_picker_confirm">Confirm</string>
    <!-- The dialog stacks three identical stepper rows, so the field name has
         to be in the description or a screen reader user cannot tell the year
         control from the day control. -->
    <string name="date_picker_decrease">Decrease %1$s</string>
    <string name="date_picker_increase">Increase %1$s</string>

    <!-- Shared loading/empty/error states. -->
    <string name="state_error_title">Something went wrong</string>
    <string name="state_error_body">Your work is safe. This screen could not load just now.</string>
    <string name="state_retry">Try again</string>
    <string name="status_in_progress">In Progress</string>
    <string name="status_completed">Completed</string>
    <string name="status_delivered">Delivered</string>

    <!-- Shared work-entry row. Lived per feature module until the row itself
         was shared; kept here so both lists say the same thing. -->
    <string name="work_qty_label">Qty: %1$d</string>
    <!-- A row's forward action. Verbs, not status names: labelled with the
         next status, the button read as a second status beside the first. -->
    <string name="action_mark_complete">Mark done</string>
    <string name="action_mark_delivered">Mark delivered</string>
    <!-- Read by screen readers on a row's action button: what it does, then
         which entry it does it to, joined the way this language joins them. -->
    <string name="action_for_entry">%1$s, %2$s</string>
    <!-- Read with an entry card that has a photo, in place of its small photo icon. -->
    <string name="work_has_photo">Photo attached</string>

    <!-- Recovery: the full screen shown instead of the app while the database is refused. -->
    <string name="recovery_title">Trackora has paused your work log</string>
    <string name="recovery_body_paused">Trackora found a problem in its database and stopped using it, so that none of your work is lost or written over.</string>
    <string name="recovery_body_kept">Nothing has been deleted. The database is kept on this phone as it is, along with copies made when the problem was found.</string>
    <!-- %1$s: the date, in the calendar the language uses. -->
    <string name="recovery_recorded_on">Problem found on %1$s</string>
    <string name="recovery_check_again">Check the database again</string>
    <string name="recovery_checking">Checking…</string>
    <string name="recovery_check_limits">A passing check means the database file is structurally sound. It can\'t prove that every entry is complete or correct.</string>
    <string name="recovery_passed_title">The database passed the check</string>
    <string name="recovery_passed_body">Trackora needs to restart to open it.</string>
    <string name="recovery_restart">Restart Trackora</string>
    <string name="recovery_restart_fallback">If Trackora doesn\'t open again by itself, open it from your home screen.</string>
    <string name="recovery_failed_damaged">The database still has problems, so Trackora keeps it paused. Nothing was changed.</string>
    <string name="recovery_failed_space">There isn\'t enough free storage to check the database. Free up some space and try again.</string>
    <string name="recovery_failed_changed">The database changed while it was being checked. Try again.</string>
    <string name="recovery_failed_other">The check couldn\'t be completed. Nothing was changed.</string>
</resources>
