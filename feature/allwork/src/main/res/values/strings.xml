<resources>
    <string name="all_work_title">All Work</string>
    <string name="filter_all">All</string>
    <string name="filter_in_progress">In Progress</string>
    <string name="filter_completed">Completed</string>
    <string name="filter_delivered">Delivered</string>
    <string name="empty_all_work">No work entries yet</string>
    <string name="qty_label">Qty: %1$d</string>
    <string name="delete_entry">Delete</string>
    <string name="entry_deleted">Deleted “%1$s”</string>
    <string name="undo">Undo</string>
    <string name="entry_status_changed">Updated “%1$s”</string>
    <string name="search_hint">Search work</string>
    <string name="search_clear">Clear search</string>
    <string name="search_no_results_title">No matching work</string>
    <string name="search_no_results_body">Try a different word, or clear the filters.</string>
    <!-- How many entries the current search and filter leave, under the title. -->
    <plurals name="all_work_count">
        <item quantity="one">%1$d entry</item>
        <item quantity="other">%1$d entries</item>
    </plurals>
    <!-- Under the title when a filter or search narrows the list. -->
    <plurals name="all_work_count_of">
        <item quantity="one">%1$d of %2$d entry</item>
        <item quantity="other">%1$d of %2$d entries</item>
    </plurals>
    <!-- Units recorded, the same word Today uses for them. -->
    <plurals name="all_work_items">
        <item quantity="one">%1$d item</item>
        <item quantity="other">%1$d items</item>
    </plurals>
    <!-- Joins a count of entries and a count of items: "11 entries · 46 items". -->
    <string name="all_work_summary">%1$s · %2$s</string>
    <!-- Clears the search and the status filter when they hide everything. -->
    <string name="all_work_show_all">Show all work</string>
</resources>
