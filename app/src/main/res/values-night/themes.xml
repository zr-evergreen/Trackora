<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme for night mode using AppCompat. -->
    <!-- This theme is used for system UI elements and is complemented by Material 3 Compose theme. -->
    <style name="Theme.Trackora" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Primary brand color - Lighter blue for dark theme -->
        <item name="colorPrimary">@color/purple_200</item>
        <item name="colorPrimaryDark">@color/trackora_blue_dark</item>
        <item name="colorAccent">@color/teal_200</item>
        
        <!-- Status bar - matches Material 3 dark background -->
        <item name="android:statusBarColor">@color/trackora_gray_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Navigation bar -->
        <item name="android:navigationBarColor">@color/trackora_gray_dark</item>
        <item name="android:windowLightNavigationBar">false</item>
        
        <!-- Window background -->
        <item name="android:windowBackground">@color/trackora_gray_dark</item>
        
        <!-- Customize your theme here. -->
    </style>
</resources>