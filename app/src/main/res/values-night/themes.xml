<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme for night mode using AppCompat. -->
    <!-- This theme is used for system UI elements and is complemented by Material 3 Compose theme. -->
    <!--
        Only Base.Theme.Trackora is overridden here. Theme.Trackora itself is
        inherited from values/ (and from values-night-v27 on API 27+), so the
        night colours flow through the parent without being repeated.
    -->
    <style name="Base.Theme.Trackora" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Ink indigo for the dark theme, matching the Compose theme. -->
        <item name="colorPrimary">@color/trackora_primary_dark_theme</item>
        <item name="colorPrimaryDark">@color/trackora_background_dark_theme</item>
        <item name="colorAccent">@color/trackora_accent_dark_theme</item>

        <!-- Status bar - matches the Compose dark background -->
        <item name="android:statusBarColor">@color/trackora_background_dark_theme</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Navigation bar -->
        <!-- android:windowLightNavigationBar is set in values-night-v27. -->
        <item name="android:navigationBarColor">@color/trackora_background_dark_theme</item>

        <!-- Window background -->
        <item name="android:windowBackground">@color/trackora_background_dark_theme</item>

        <!-- Customize your theme here. -->
    </style>
</resources>
