<resources>
    <!--
        Android 12 and later can animate the splash icon, so the seal enters:
        its lower parts rise into place and the top part steps up onto them.
        Earlier versions show it still (values/themes.xml).
    -->
    <style name="Theme.Trackora.Starting" parent="Base.Theme.Trackora.Starting">
        <item name="android:windowLightNavigationBar">@bool/splash_light_system_bars</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_mark_animated</item>
        <item name="windowSplashScreenAnimationDuration">@integer/splash_entrance_duration</item>
    </style>
</resources>
