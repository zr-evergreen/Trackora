<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme using AppCompat, required for AppCompatActivity. -->
    <!-- This theme is used for system UI elements and is complemented by Material 3 Compose theme. -->
    <!--
        Split into a Base.* style plus a thin Theme.Trackora on top so that
        API-gated attributes can be added in values-v27 without duplicating
        every colour. A style declared in a qualified folder replaces the whole
        style rather than merging into it, so the shared values have to live in
        a parent that the qualified variant can inherit from.
    -->
    <style name="Base.Theme.Trackora" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Ink indigo, matching the Compose theme's primary. -->
        <item name="colorPrimary">@color/trackora_primary</item>
        <item name="colorPrimaryDark">@color/trackora_primary_container</item>
        <item name="colorAccent">@color/trackora_accent</item>

        <!-- Status bar - matches Material 3 background -->
        <item name="android:statusBarColor">@color/trackora_background</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Navigation bar -->
        <!-- android:windowLightNavigationBar is set in values-v27; it needs
             API 27 and is simply absent on Android 7 and 8.0. -->
        <item name="android:navigationBarColor">@color/trackora_background</item>

        <!-- Window background -->
        <item name="android:windowBackground">@color/trackora_background</item>

        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.Trackora" parent="Base.Theme.Trackora" />

    <!--
        The launch theme. Android 12 and later draw their own splash screen for
        every app; core-splashscreen draws the same one on Android 7 to 11, so
        the app has exactly one splash, the platform's, on every version:
        the Trackora mark on the app's own background. MainActivity installs it
        before anything else, and it swaps in Theme.Trackora as soon as the
        first screen is ready to draw.

        The system bars take the splash's colour, so they do not change when
        the first screen appears.
    -->
    <style name="Base.Theme.Trackora.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.Trackora</item>
        <item name="android:statusBarColor">@color/splash_background</item>
        <item name="android:navigationBarColor">@color/splash_background</item>
        <item name="android:windowLightStatusBar">@bool/splash_light_system_bars</item>
    </style>

    <style name="Theme.Trackora.Starting" parent="Base.Theme.Trackora.Starting" />
</resources>
