<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Only what the XML theme needs before Compose draws: the launch window
        and the system bars. Every colour on screen comes from the Compose
        theme (core/common ui/theme), and these mirror its values so the first
        frame does not flash a different background.
    -->
    <color name="trackora_primary">#2B4ACB</color>
    <color name="trackora_primary_container">#102A8C</color>
    <color name="trackora_accent">#00696A</color>
    <color name="trackora_background">#FAF8F5</color>

    <color name="trackora_primary_dark_theme">#B9C3FF</color>
    <color name="trackora_accent_dark_theme">#7FD6D0</color>
    <color name="trackora_background_dark_theme">#131317</color>

    <!--
        The splash screen: the app's own background, so the splash hands over
        to the first screen without a change of colour, and the mark in ink
        indigo with a saffron thread. The thread is a deeper saffron than the
        icon's, which is drawn for indigo and would wash out on paper. The
        night values are in values-night/colors.xml.
    -->
    <color name="splash_background">#FAF8F5</color>
    <color name="splash_mark">#2B4ACB</color>
    <color name="splash_thread">#F0961C</color>
</resources>
