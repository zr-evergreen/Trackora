# Keystore Configuration
# Copy this file to keystore.properties and fill in your actual values
# DO NOT commit keystore.properties to version control!

storeFile=../path/to/your/keystore.jks
storePassword=your_store_password
keyAlias=your_key_alias
keyPassword=your_key_password

# Instructions:
# 1. Generate a keystore using:
#    keytool -genkey -v -keystore trackora-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias trackora
# 2. Copy this file to keystore.properties
# 3. Fill in the actual values
# 4. Add keystore.properties to .gitignore (already done)



